---
import { suwar, atman } from "../data/index";
import Layout from "../layouts/Layout.astro";

const atmanEntries = Object.entries(atman);
---

<Layout>
  <body
    class="bg-gradient-to-br from-slate-900 via-emerald-950 to-slate-900 text-slate-100 min-h-screen py-10 px-4 sm:px-6 lg:px-8"
  >
    <main class="max-w-4xl mx-auto space-y-8">
      <!-- Header -->
      <header
        class="text-center space-y-3 py-6 bg-slate-900/60 backdrop-blur-md rounded-3xl border border-emerald-500/20 shadow-2xl"
      >
        <h1
          class="text-3xl sm:text-4xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-emerald-300 via-teal-200 to-emerald-400"
        >
          نسخ موجه خطة الحفظ للذكاء الاصطناعي
        </h1>
        <p class="text-slate-400 text-sm sm:text-base max-w-lg mx-auto">
          اختر الأثمان وحدد الفترة الزمنية (بالأشهر، بحد أدنى شهر)، ثم انسخ
          الموجه الجاهز لتغذية الذكاء الاصطناعي بملف HTML/CSS واحد.
        </p>
      </header>

      <!-- Form Section -->
      <section
        class="bg-slate-900/85 backdrop-blur-md rounded-3xl border border-slate-800 p-6 sm:p-8 space-y-6 shadow-xl"
      >
        <!-- Duration -->
        <div class="space-y-3">
          <label class="block text-lg font-bold text-emerald-400"
            >1. تحديد الفترة الزمنية (بالأشهر - الحد الأدنى شهر)</label
          >
          <div class="flex items-center gap-4">
            <input
              type="number"
              id="months-input"
              min="1"
              value="1"
              class="w-32 bg-slate-800 border border-slate-700 rounded-xl px-4 py-2.5 text-slate-100 focus:outline-none focus:border-emerald-500 font-bold text-lg text-center"
            />
            <span class="text-slate-400 font-medium"
              >أشهر (كل شهر = 4 أسابيع)</span
            >
          </div>
        </div>

        <!-- Atman Selection -->
        <div class="space-y-4 pt-4 border-t border-slate-800">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <label class="text-lg font-bold text-emerald-400"
              >2. حدد الأثمان المراد حفظها</label
            >
            <div class="flex gap-2">
              <button
                type="button"
                id="select-all"
                class="px-3 py-1.5 text-xs bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700 rounded-lg transition-all cursor-pointer"
                >تحديد الكل</button
              >
              <button
                type="button"
                id="deselect-all"
                class="px-3 py-1.5 text-xs bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700 rounded-lg transition-all cursor-pointer"
                >إلغاء التحديد</button
              >
            </div>
          </div>

          <div
            class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-2.5 max-h-72 overflow-y-auto p-3 bg-slate-950/50 rounded-2xl border border-slate-800"
          >
            {
              atmanEntries.map(([num, range]) => (
                <label class="flex items-center gap-2 p-2.5 rounded-xl bg-slate-800/40 border border-slate-800 hover:border-emerald-500/40 cursor-pointer transition-all select-none">
                  <input
                    type="checkbox"
                    name="atman-checkbox"
                    value={num}
                    class="w-4 h-4 rounded text-emerald-600 bg-slate-900 border-slate-700 focus:ring-emerald-500 focus:ring-offset-slate-900"
                  />
                  <span class="text-xs font-semibold text-slate-200">
                    الثمن {num}
                  </span>
                </label>
              ))
            }
          </div>
        </div>

        <!-- Action Button & Notification -->
        <div class="pt-4 space-y-3">
          <button
            type="button"
            id="copy-prompt-btn"
            class="w-full py-3.5 rounded-2xl bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-500 hover:to-teal-500 text-white font-bold text-lg shadow-lg shadow-emerald-900/30 transition-all cursor-pointer flex items-center justify-center gap-2"
          >
            <span>📋 نسخ موجه الذكاء الاصطناعي</span>
          </button>

          <div
            id="toast"
            class="hidden p-3 rounded-xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-300 text-center text-sm font-medium animate-pulse"
          >
            تم نسخ الموجه بنجاح إلى الحافظة! الصقه الآن للذكاء الاصطناعي 🚀
          </div>
        </div>
      </section>

      <!-- Preview Box for the Prompt -->
      <section
        class="bg-slate-900/60 backdrop-blur-md rounded-3xl border border-slate-800 p-6 space-y-3"
      >
        <h3 class="text-sm font-bold text-slate-400">
          معاينة نص الموجه الذي سيتم نسخه:
        </h3>
        <textarea
          id="prompt-preview"
          rows="6"
          readonly
          class="w-full bg-slate-950/70 border border-slate-800 rounded-2xl p-4 text-xs text-slate-300 focus:outline-none resize-none font-mono"
          placeholder="اختر الأثمان والمدة لتظهر معاينة الموجه هنا..."
        ></textarea>
      </section>
    </main>

    <script define:vars={{ atmanData: atman, suwarData: suwar }}>
      const selectAllBtn = document.getElementById("select-all");
      const deselectAllBtn = document.getElementById("deselect-all");
      const checkboxes = document.querySelectorAll(
        'input[name="atman-checkbox"]',
      );
      const copyPromptBtn = document.getElementById("copy-prompt-btn");
      const monthsInput = document.getElementById("months-input");
      const promptPreview = document.getElementById("prompt-preview");
      const toast = document.getElementById("toast");

      selectAllBtn.addEventListener("click", () => {
        checkboxes.forEach((cb) => (cb.checked = true));
        updatePreview();
      });

      deselectAllBtn.addEventListener("click", () => {
        checkboxes.forEach((cb) => (cb.checked = false));
        updatePreview();
      });

      checkboxes.forEach((cb) => cb.addEventListener("change", updatePreview));
      monthsInput.addEventListener("input", updatePreview);

      function buildPromptText() {
        const selectedIds = Array.from(checkboxes)
          .filter((cb) => cb.checked)
          .map((cb) => Number(cb.value))
          .sort((a, b) => a - b);

        const months = Math.max(1, parseInt(monthsInput.value, 10) || 1);

        if (selectedIds.length === 0) {
          return "الرجاء اختيار ثمن واحد على الأقل وتحديد الفترة لتوليد الموجه.";
        }

        let selectedDetails = selectedIds
          .map((id) => {
            const range = atmanData[id];
            const startSurah =
              suwarData[range.start.surah]?.ar || `سورة ${range.start.surah}`;
            const endSurah =
              suwarData[range.end.surah]?.ar || `سورة ${range.end.surah}`;
            return `- الثمن ${id}: من ${startSurah} (آية ${range.start.ayah}) إلى ${endSurah} (آية ${range.end.ayah})`;
          })
          .join("\n");

        return `أريدك أن تكتب لي كود ملف HTML واحد (Single HTML file) متكامل مع تنسيقات Tailwind CSS وجماليات بصرية عالية (Dark mode عصري، تصميم نظيف، خط تجامل وأميري للقرآن) يعمل كـ "مخطط تفاعلي لحفظ الأثمان القرآنية برواية نافع المدني".

تفاصيل الخطة المطلوبة:
- المدة الزمنية: ${months} أشهر (بواقع 4 أسابيع لكل شهر، إجمالي ${months * 4} أسبوعاً).
- الأثمان المطلوب جدولتها وتوزيعها بالتساوي على الأسابيع:
${selectedDetails}

المطلوب في ملف الـ HTML الناتج:
1. واجهة مستخدم احترافية باللغة العربية (RTL) مع تصميم جذاب.
2. جدول أو بطاقات أسبوعية توضح بوضوح الأسابيع وما يتبعها من أثمان مع تفاصيل بداية ونهاية كل ثمن.
3. إمكانية تفاعل بسيطة (مثل تحديد الأثمان المكتملة أو حفظ التقدم في الـ LocalStorage).
4. كود نظيف، متكامل، وجاهز للنسخ والتشغيل مباشرة في متصفح الويب ضمن صندوق أكواد واحد فقط.`;
      }

      function updatePreview() {
        promptPreview.value = buildPromptText();
      }

      copyPromptBtn.addEventListener("click", () => {
        const textToCopy = buildPromptText();
        if (textToCopy.startsWith("الرجاء")) {
          alert("الرجاء اختيار ثمن واحد على الأقل أولاً.");
          return;
        }

        navigator.clipboard.writeText(textToCopy).then(() => {
          toast.classList.remove("hidden");
          setTimeout(() => {
            toast.classList.add("hidden");
          }, 4000);
        });
      });

      // Initial preview load
      updatePreview();
    </script>
  </body>
</Layout>
