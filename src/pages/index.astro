---
import { suwar, ahzab, atman } from "../data/index";
import "../globals.css";
// Helper function with fixed typing for indexing
const formatCursor = (cursor: { surah: number; ayah: number }) => {
  const surahName = suwar[`${cursor.surah}`]?.ar || `سورة ${cursor.surah}`;
  return `${surahName} (الآية ${cursor.ayah})`;
};
---

<html lang="ar" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>فهارس القرآن الكريم | Quran Navigator</title>
    <!-- Importing a clean Arabic font from Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&family=Tajawal:wght@400;500;700;800&display=swap"
      rel="stylesheet"
    />
    <style>
      body {
        font-family: "Tajawal", sans-serif;
      }
      .quran-font {
        font-family: "Amiri", serif;
      }
    </style>
  </head>
  <body
    class="bg-linear-to-br from-slate-900 via-emerald-950 to-slate-900 text-slate-100 min-h-screen py-12 px-4 sm:px-6 lg:px-8"
  >
    <main class="max-w-6xl mx-auto space-y-10">
      <!-- Hero Header -->
      <header
        class="text-center space-y-4 py-8 bg-slate-900/60 backdrop-blur-md rounded-3xl border border-emerald-500/20 shadow-2xl"
      >
        <div
          class="inline-flex items-center justify-center p-3 bg-emerald-500/10 rounded-2xl text-emerald-400 mb-2 border border-emerald-500/20"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-8 w-8"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"
            ></path>
          </svg>
        </div>
        <h1
          class="text-4xl sm:text-5xl font-extrabold text-transparent bg-clip-text bg-linear-to-r from-emerald-300 via-teal-200 to-emerald-400"
        >
          فهارس القرآن الكريم
        </h1>
        <p class="text-slate-400 text-lg max-w-xl mx-auto">
          مرجعك المتكامل لاستعراض السور، والأحزاب، والأثمان بدقة وسهولة.
        </p>
      </header>

      <!-- Navigation Tabs / Section Selector (Visual Only) -->
      <div class="flex flex-wrap justify-center gap-3">
        <a
          href="#suwar"
          class="px-6 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-medium shadow-lg shadow-emerald-900/30 transition-all"
          >السور</a
        >
        <a
          href="#ahzab"
          class="px-6 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700 font-medium transition-all"
          >الأحزاب</a
        >
        <a
          href="#atman"
          class="px-6 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700 font-medium transition-all"
          >الأثمان</a
        >
      </div>

      <!-- Suwar Section -->
      <section
        id="suwar"
        class="bg-slate-900/80 backdrop-blur-md rounded-3xl border border-slate-800 p-6 sm:p-8 space-y-6 shadow-xl"
      >
        <div
          class="flex items-center justify-between border-b border-slate-800 pb-4"
        >
          <div>
            <h2 class="text-2xl font-bold text-emerald-400">السور المباركة</h2>
            <p class="text-xs text-slate-400 mt-1">إجمالي 114 سورة قرآنية</p>
          </div>
          <span
            class="px-3 py-1 bg-emerald-500/10 text-emerald-400 text-xs font-semibold rounded-full border border-emerald-500/20"
            >Suwar</span
          >
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {
            Object.entries(suwar).map(([number, surah]) => (
              <div class="group flex items-center justify-between p-4 rounded-2xl bg-slate-800/50 border border-slate-800 hover:border-emerald-500/40 hover:bg-slate-800 transition-all">
                <div class="flex items-center gap-4">
                  <span class="w-10 h-10 rounded-xl bg-emerald-500/10 text-emerald-400 font-bold flex items-center justify-center border border-emerald-500/20 group-hover:bg-emerald-500 group-hover:text-slate-950 transition-colors">
                    {number}
                  </span>
                  <div>
                    <h3 class="quran-font font-bold text-slate-100 text-xl">
                      {surah.ar}
                    </h3>
                    <span class="text-xs text-slate-400 tracking-wide">
                      {surah.en}
                    </span>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </section>

      <!-- Ahzab Section -->
      <section
        id="ahzab"
        class="bg-slate-900/80 backdrop-blur-md rounded-3xl border border-slate-800 p-6 sm:p-8 space-y-6 shadow-xl"
      >
        <div
          class="flex items-center justify-between border-b border-slate-800 pb-4"
        >
          <div>
            <h2 class="text-2xl font-bold text-teal-400">الأحزاب القرآنية</h2>
            <p class="text-xs text-slate-400 mt-1">تقسيم القرآن إلى 60 حزباً</p>
          </div>
          <span
            class="px-3 py-1 bg-teal-500/10 text-teal-400 text-xs font-semibold rounded-full border border-teal-500/20"
            >Ahzab</span
          >
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {
            Object.entries(ahzab).map(([number, range]) => (
              <div class="p-5 rounded-2xl bg-slate-800/50 border border-slate-800 hover:border-teal-500/40 transition-all space-y-3">
                <div class="flex items-center justify-between">
                  <span class="text-xs font-bold bg-teal-500/10 text-teal-300 px-3 py-1 rounded-lg border border-teal-500/20">
                    الحزب {number}
                  </span>
                </div>
                <div class="text-xs text-slate-300 space-y-2 bg-slate-900/50 p-3 rounded-xl border border-slate-800">
                  <div class="flex justify-between items-center">
                    <span class="text-slate-400 font-medium">البداية:</span>
                    <span class="font-semibold text-emerald-300">
                      {formatCursor(range.start)}
                    </span>
                  </div>
                  <div class="flex justify-between items-center">
                    <span class="text-slate-400 font-medium">النهاية:</span>
                    <span class="font-semibold text-emerald-300">
                      {formatCursor(range.end)}
                    </span>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </section>

      <!-- Atman Section -->
      <!-- Atman Section -->
      <section
        id="atman"
        class="bg-slate-900/80 backdrop-blur-md rounded-3xl border border-slate-800 p-6 sm:p-8 space-y-6 shadow-xl"
      >
        <div
          class="flex items-center justify-between border-b border-slate-800 pb-4"
        >
          <div>
            <h2 class="text-2xl font-bold text-amber-400">الأثمان (Atman)</h2>
            <p class="text-xs text-slate-400 mt-1">
              تقسيم الأحزاب إلى أثمان (كل ثمن = نصف ربع)
            </p>
          </div>
          <span
            class="px-3 py-1 bg-amber-500/10 text-amber-400 text-xs font-semibold rounded-full border border-amber-500/20"
            >Thumn / Atman</span
          >
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          {
            Object.entries(atman).map(([number, range]) => (
              <div class="p-4 rounded-2xl bg-slate-800/50 border border-slate-800 hover:border-amber-500/40 transition-all space-y-2.5">
                <div class="flex items-center justify-between">
                  <span class="text-xs font-bold bg-amber-500/10 text-amber-300 px-2.5 py-1 rounded-lg border border-amber-500/20">
                    الثمن {number}
                  </span>
                </div>
                <div class="text-xs text-slate-300 space-y-1.5 bg-slate-900/50 p-2.5 rounded-xl border border-slate-800">
                  <div class="flex justify-between items-center">
                    <span class="text-slate-400 font-medium">من:</span>
                    <span class="font-medium text-amber-200">
                      {formatCursor(range.start)}
                    </span>
                  </div>
                  <div class="flex justify-between items-center">
                    <span class="text-slate-400 font-medium">إلى:</span>
                    <span class="font-medium text-amber-200">
                      {formatCursor(range.end)}
                    </span>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </section>
    </main>
  </body>
</html>
