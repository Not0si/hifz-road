---
import Layout from "../layouts/Layout.astro";
import { suwar, ahzab, atman } from "../data/index";

// Group Atman by Hizb (Each Hizb contains 8 Atman)
const hizbGroups = Array.from({ length: 60 }, (_, i) => {
  const hizbNumber = i + 1;
  const atmanList = [1, 2, 3, 4, 5, 6, 7, 8]
    .map((q) => {
      const atmanId = i * 8 + q;
      return { id: atmanId, range: atman[`${atmanId}`] };
    })
    .filter((item) => item.range);

  return {
    hizbNumber,
    hizbRange: ahzab[`${hizbNumber}`],
    atmanList,
  };
});
---

<Layout
  className="bg-slate-950 text-slate-100 min-h-screen py-8 px-4 sm:px-6 lg:px-8 font-sans selection:bg-emerald-500 selection:text-white"
  title="مخطط حفظ الأثمان | Planner Prompt Builder"
>
  <main class="max-w-5xl mx-auto space-y-6 py-6">
    <!-- Hero Header -->
    <header
      class="text-center space-y-3 py-8 px-6 rounded-3xl bg-gradient-to-b from-emerald-950/40 via-slate-900/60 to-slate-900/40 border border-emerald-500/10 backdrop-blur-xl relative overflow-hidden shadow-2xl"
    >
      <div
        class="absolute -top-24 -left-24 w-60 h-60 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none"
      >
      </div>
      <div
        class="absolute -bottom-24 -right-24 w-60 h-60 bg-teal-500/10 rounded-full blur-3xl pointer-events-none"
      >
      </div>

      <span
        class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20"
      >
        ✨ أداة توليد الموجهات الذكية
      </span>
      <h1
        class="text-3xl sm:text-4xl font-extrabold tracking-tight text-white font-serif"
      >
        مخطط حفظ الأثمان <span class="text-emerald-400">حسب الأحزاب</span>
      </h1>
      <p
        class="text-slate-400 text-sm sm:text-base max-w-lg mx-auto leading-relaxed"
      >
        اختر الأثمان المطلوبة وحدد تاريخ البداية والنهاية لتوليد موجه AI مخصص
        وجاهز للنسخ.
      </p>
    </header>

    <!-- Main Control Panel -->
    <div
      class="bg-slate-900/80 border border-slate-800 rounded-3xl p-6 space-y-6 shadow-xl backdrop-blur-md"
    >
      <!-- Section 1: Date Range Selector -->
      <div
        class="flex flex-col md:flex-row md:items-center justify-between gap-6 pb-6 border-b border-slate-800/80"
      >
        <div>
          <h2
            class="text-base font-bold text-slate-100 flex items-center gap-2"
          >
            <span
              class="flex items-center justify-center w-6 h-6 rounded-full bg-emerald-500/10 text-emerald-400 text-xs font-bold border border-emerald-500/20"
              >1</span
            >
            تحديد الفترة الزمنية (تاريخ البداية والنهاية)
          </h2>
          <p class="text-xs text-slate-400 mt-1">
            حدد تاريخ بدء الخطة وانتهائها ليتم احتساب الأسابيع تلقائياً
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-3">
          <!-- Start Date -->
          <div
            class="flex items-center gap-2 bg-slate-950/60 px-3 py-2 rounded-2xl border border-slate-800"
          >
            <label
              for="start-date-input"
              class="text-xs text-slate-400 font-medium">من:</label
            >
            <input
              type="date"
              id="start-date-input"
              class="bg-slate-900 border border-slate-700/80 rounded-xl px-2.5 py-1.5 text-slate-100 text-xs font-medium focus:outline-none focus:border-emerald-500 cursor-pointer"
            />
          </div>

          <!-- End Date -->
          <div
            class="flex items-center gap-2 bg-slate-950/60 px-3 py-2 rounded-2xl border border-slate-800"
          >
            <label
              for="end-date-input"
              class="text-xs text-slate-400 font-medium">إلى:</label
            >
            <input
              type="date"
              id="end-date-input"
              class="bg-slate-900 border border-slate-700/80 rounded-xl px-2.5 py-1.5 text-slate-100 text-xs font-medium focus:outline-none focus:border-emerald-500 cursor-pointer"
            />
          </div>
        </div>
      </div>

      <!-- Section 2: Atman Selection -->
      <div class="space-y-4">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <div>
            <h2
              class="text-base font-bold text-slate-100 flex items-center gap-2"
            >
              <span
                class="flex items-center justify-center w-6 h-6 rounded-full bg-emerald-500/10 text-emerald-400 text-xs font-bold border border-emerald-500/20"
                >2</span
              >
              اختيار الأثمان والأحزاب
            </h2>
            <p class="text-xs text-slate-400 mt-0.5">
              انقر على الأثمان الفردية أو حدد الحزب بالكامل
            </p>
          </div>

          <div class="flex items-center gap-2">
            <button
              type="button"
              id="select-all"
              class="px-3 py-1.5 text-xs font-medium bg-slate-800 hover:bg-slate-700/80 text-slate-300 border border-slate-700 rounded-xl transition-all cursor-pointer"
            >
              تحديد الكل
            </button>
            <button
              type="button"
              id="deselect-all"
              class="px-3 py-1.5 text-xs font-medium bg-slate-800 hover:bg-slate-700/80 text-slate-400 border border-slate-700 rounded-xl transition-all cursor-pointer hover:text-slate-200"
            >
              إلغاء التحديد
            </button>
          </div>
        </div>

        <!-- Hizb Groups Grid -->
        <div
          class="space-y-3 max-h-[520px] overflow-y-auto pr-1 pl-1 scrollbar-thin scrollbar-thumb-slate-800"
        >
          {
            hizbGroups.map((hizb) => (
              <details class="group bg-slate-950/40 border border-slate-800/80 rounded-2xl overflow-hidden transition-all duration-200 [&[open]]:bg-slate-950/80 [&[open]]:border-emerald-500/30">
                <summary class="flex items-center justify-between px-4 py-3 cursor-pointer select-none list-none hover:bg-slate-900/50 transition-colors">
                  <div class="flex items-center gap-3">
                    <span class="w-2 h-2 rounded-full bg-emerald-500 group-open:scale-125 transition-transform" />
                    <span class="font-bold text-sm text-slate-200">
                      الحزب رقم {hizb.hizbNumber}
                    </span>
                    <span class="text-xs text-slate-500 font-medium">
                      (8 أثمان)
                    </span>
                  </div>

                  <div class="flex items-center gap-3">
                    <button
                      type="button"
                      class="select-hizb-btn text-xs font-medium bg-emerald-500/10 text-emerald-400 px-3 py-1 rounded-lg border border-emerald-500/20 hover:bg-emerald-500/20 transition-all cursor-pointer"
                      data-hizb={hizb.hizbNumber}
                    >
                      تحديد الحزب كامل
                    </button>

                    <svg
                      class="w-4 h-4 text-slate-400 group-open:rotate-180 transition-transform"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M19 9l-7 7-7-7"
                      />
                    </svg>
                  </div>
                </summary>

                <div class="p-4 border-t border-slate-800/50 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-2.5 bg-slate-900/30">
                  {hizb.atmanList.map((atmanItem) => {
                    const startSurah =
                      suwar[`${atmanItem.range.start.surah}`]?.ar ||
                      `سورة ${atmanItem.range.start.surah}`;
                    const endSurah =
                      suwar[`${atmanItem.range.end.surah}`]?.ar ||
                      `سورة ${atmanItem.range.end.surah}`;
                    return (
                      <label class="relative flex items-start gap-3 p-3 rounded-xl bg-slate-900/60 border border-slate-800 hover:border-emerald-500/40 cursor-pointer transition-all has-[:checked]:bg-emerald-950/20 has-[:checked]:border-emerald-500/50 group/item select-none">
                        <input
                          type="checkbox"
                          name="atman-checkbox"
                          value={atmanItem.id}
                          data-hizb={hizb.hizbNumber}
                          class="mt-1 w-4 h-4 rounded border-slate-700 bg-slate-950 text-emerald-500 focus:ring-emerald-500 focus:ring-offset-slate-900 transition-all cursor-pointer"
                        />
                        <div class="space-y-1 text-xs">
                          <div class="font-bold text-slate-200 group-has-[:checked]/item:text-emerald-300">
                            الثمن {atmanItem.id}
                          </div>
                          <div class="text-slate-400 text-[11px] leading-tight">
                            من:{" "}
                            <span class="text-slate-300 font-medium">
                              {startSurah} ({atmanItem.range.start.ayah})
                            </span>
                          </div>
                          <div class="text-slate-400 text-[11px] leading-tight">
                            إلى:{" "}
                            <span class="text-slate-300 font-medium">
                              {endSurah} ({atmanItem.range.end.ayah})
                            </span>
                          </div>
                        </div>
                      </label>
                    );
                  })}
                </div>
              </details>
            ))
          }
        </div>
      </div>

      <!-- Copy Action CTA -->
      <div class="pt-4 border-t border-slate-800 space-y-3">
        <button
          type="button"
          id="copy-prompt-btn"
          class="w-full py-4 rounded-2xl bg-gradient-to-r from-emerald-600 via-teal-600 to-emerald-600 hover:opacity-95 text-white font-bold text-base shadow-lg shadow-emerald-950/50 transition-all cursor-pointer flex items-center justify-center gap-2 group active:scale-[0.99]"
        >
          <svg
            class="w-5 h-5 text-emerald-200 group-hover:scale-110 transition-transform"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"
            ></path>
          </svg>
          <span>نسخ موجه الذكاء الاصطناعي (AI Prompt)</span>
        </button>

        <div
          id="toast"
          class="hidden p-3 rounded-xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-300 text-center text-xs sm:text-sm font-medium animate-fade-in"
        >
          ✅ تم نسخ الموجه بنجاح إلى الحافظة!
        </div>
      </div>
    </div>

    <!-- Output Preview Box -->
    <section
      class="bg-slate-900/50 border border-slate-800 rounded-3xl p-5 space-y-3"
    >
      <div class="flex items-center justify-between">
        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400">
          معاينة نص الموجه
        </h3>
        <span class="text-[11px] text-slate-500 font-mono">Auto-generated</span>
      </div>
      <textarea
        id="prompt-preview"
        rows="6"
        readonly
        class="w-full bg-slate-950/80 border border-slate-800/80 rounded-2xl p-4 text-xs text-slate-300 focus:outline-none resize-none font-mono leading-relaxed"
        placeholder="اختر الأثمان والتواريخ لتظهر المعاينة هنا..."></textarea>
    </section>
  </main>

  <script define:vars={{ atmanData: atman, suwarData: suwar }}>
    const selectAllBtn = document.getElementById("select-all");
    const deselectAllBtn = document.getElementById("deselect-all");
    const checkboxes = document.querySelectorAll(
      'input[name="atman-checkbox"]',
    );
    const hizbSelectButtons = document.querySelectorAll(".select-hizb-btn");
    const copyPromptBtn = document.getElementById("copy-prompt-btn");
    const startDateInput = document.getElementById("start-date-input");
    const endDateInput = document.getElementById("end-date-input");
    const promptPreview = document.getElementById("prompt-preview");
    const toast = document.getElementById("toast");

    // Initialize Default Dates (Today -> +1 Month)
    const today = new Date();
    const nextMonth = new Date();
    nextMonth.setMonth(today.getMonth() + 1);

    startDateInput.value = today.toISOString().split("T")[0];
    endDateInput.value = nextMonth.toISOString().split("T")[0];

    selectAllBtn.addEventListener("click", () => {
      checkboxes.forEach((cb) => (cb.checked = true));
      updatePreview();
    });

    deselectAllBtn.addEventListener("click", () => {
      checkboxes.forEach((cb) => (cb.checked = false));
      updatePreview();
    });

    hizbSelectButtons.forEach((btn) => {
      btn.addEventListener("click", (e) => {
        e.preventDefault();
        const hizbNum = btn.getAttribute("data-hizb");
        const hizbCheckboxes = document.querySelectorAll(
          `input[name="atman-checkbox"][data-hizb="${hizbNum}"]`,
        );
        const allChecked = Array.from(hizbCheckboxes).every((cb) => cb.checked);
        hizbCheckboxes.forEach((cb) => (cb.checked = !allChecked));
        updatePreview();
      });
    });

    checkboxes.forEach((cb) => cb.addEventListener("change", updatePreview));
    startDateInput.addEventListener("change", updatePreview);
    endDateInput.addEventListener("change", updatePreview);

    function buildPromptText() {
      const selectedIds = Array.from(checkboxes)
        .filter((cb) => cb.checked)
        .map((cb) => Number(cb.value))
        .sort((a, b) => a - b);

      if (selectedIds.length === 0) {
        return "الرجاء اختيار ثمن واحد على الأقل لتوليد الموجه.";
      }

      const startDateVal = startDateInput.value;
      const endDateVal = endDateInput.value;

      if (!startDateVal || !endDateVal) {
        return "الرجاء تحديد تاريخ البداية وتاريخ النهاية أولاً.";
      }

      const start = new Date(startDateVal);
      const end = new Date(endDateVal);

      if (end <= start) {
        return "تنبيه: يجب أن يكون تاريخ النهاية بعد تاريخ البداية.";
      }

      // Calculate Duration
      const diffTime = Math.abs(end - start);
      const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
      const diffWeeks = Math.max(1, Math.ceil(diffDays / 7));

      let selectedDetails = selectedIds
        .map((id) => {
          const range = atmanData[id];
          const startSurah =
            suwarData[range.start.surah]?.ar || `سورة ${range.start.surah}`;
          const endSurah =
            suwarData[range.end.surah]?.ar || `سورة ${range.end.surah}`;
          const hizbNum = Math.ceil(id / 8);
          return `الثمن ${id} (الحزب ${hizbNum}): من ${startSurah} (آية ${range.start.ayah}) إلى ${endSurah} (آية ${range.end.ayah})`;
        })
        .join("\n");

      return `أريدك أن تكتب لي كود ملف HTML واحد (Single HTML file) متكامل مع تنسيقات Tailwind CSS وجماليات بصرية عالية (Dark mode عصري، تصميم نظيف، خطوط عربية أميري وتاجوال) يعمل كـ "مخطط تفاعلي متقدم لحفظ الأثمان القرآنية برواية نافع المدني".

معلومات الخطة الزمانية:
- تاريخ البداية: ${startDateVal}
- تاريخ النهاية: ${endDateVal}
- المدة الإجمالية: ${diffDays} يوماً (تُوزّع على ${diffWeeks} أسابيع تقريباً).

الأثمان المفصلة المطلوب جدولتها وتوزيعها بالتساوي على طول هذه الفترة:
${selectedDetails}

المطلوب تنفيذه في ملف الـ HTML:
1. واجهة مستخدم احترافية باللغة العربية (RTL) تبدأ بتأريخ الأسابيع بناءً على تاريخ البداية المحدد.
2. عرض تفاصيل كل ثمن بوضوح داخل جدول الأسبوع (اسم السورة، رقم الحزب، ورقم الآيات البداية والنهاية).
3. إمكانية تفاعل المستخدم (مثل تحديد إنجاز الأسبوع وتخزين الحالة محلياً عبر LocalStorage).
4. تسليم الكود البرمجي كاملاً ونظيفاً ضمن صندوق أكواد واحد فقط جاهز للتشغيل.`;
    }

    function updatePreview() {
      promptPreview.value = buildPromptText();
    }

    copyPromptBtn.addEventListener("click", () => {
      const textToCopy = buildPromptText();
      if (textToCopy.startsWith("الرجاء") || textToCopy.startsWith("تنبيه")) {
        alert(textToCopy);
        return;
      }

      navigator.clipboard.writeText(textToCopy).then(() => {
        toast.classList.remove("hidden");
        setTimeout(() => {
          toast.classList.add("hidden");
        }, 4000);
      });
    });

    updatePreview();
  </script>
</Layout>
