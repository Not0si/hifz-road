---
import Layout from "../layouts/Layout.astro";
import { suwar, ahzab, pages } from "../data/index";

const juzGroups = Array.from({ length: 30 }, (_, i) => {
  const juzNumber = i + 1;
  const startPage = i * 20 + 1;
  const endPage = juzNumber === 30 ? 604 : (i + 1) * 20;

  const pageList = [];
  for (let p = startPage; p <= endPage; p++) {
    if (pages[`${p}`]) {
      pageList.push({ id: p, range: pages[`${p}`] });
    }
  }

  return {
    juzNumber,
    startPage,
    endPage,
    pageList,
  };
});
---

<Layout
  className="bg-[#f8f8f8] dark:bg-[#0d0d0d] text-[#0d0d0d] dark:text-[#f8f8f8] min-h-screen font-sans selection:bg-[#ff2400] selection:text-white transition-colors duration-200"
  title="HIFZ — نظام تخطيط صفحات القرآن"
>
  <style>
    @import url("https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;900&family=Space+Mono:wght@400;700&display=swap");

    :root {
      --font-primary:
        "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
        Helvetica, Arial, sans-serif;
      --font-mono: "Space Mono", monospace;
      --accent-color: #ff2400;
    }

    body {
      font-family: var(--font-primary);
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
      direction: rtl;
      text-align: right;
    }

    .border-custom {
      border: 1px solid var(--border-color, #0d0d0d);
    }
    .dark .border-custom {
      border: 1px solid #333333;
    }

    .custom-input {
      background: transparent;
      border: 1px solid currentColor;
      font-family: var(--font-mono);
      font-size: 0.8rem;
      direction: ltr;
      text-align: right;
    }
  </style>

  <!-- Top Bar -->
  <div
    class="border-b border-current py-2.5 text-xs font-mono font-bold uppercase tracking-wider bg-white dark:bg-[#111111] sticky top-0 z-50"
  >
    <div class="max-w-7xl mx-auto px-6 flex justify-between items-center">
      <div class="flex items-center gap-4">
        <span class="bg-[#ff2400] text-white px-2 py-0.5 text-[11px]"
          >SYS.05</span
        >
        <span>مخطط صفحات القرآن الكريم (604 صفحة)</span>
      </div>
      <div class="flex items-center gap-6">
        <span id="selection-counter" class="text-[#ff2400] font-mono"
          >[ تم تحديد 0 صفحة ]</span
        >
        <button
          type="button"
          id="theme-toggle-btn"
          class="cursor-pointer text-[11px] px-2.5 py-1 border border-current hover:bg-[#ff2400] hover:text-white transition-colors"
        >
          الوضع: <span id="theme-mode-label">فاتح</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Primary Navigation -->
  <header class="bg-white dark:bg-[#111111] border-b border-current py-8">
    <div
      class="max-w-7xl mx-auto px-6 grid grid-cols-1 md:grid-cols-3 gap-6 items-end"
    >
      <div>
        <a
          href="#"
          class="text-6xl font-black tracking-tighter uppercase no-underline text-current"
        >
          HIFZ<span class="text-[#ff2400]">.</span>
        </a>
      </div>
      <div
        class="text-xs font-mono text-gray-600 dark:text-gray-400 border-r border-current pr-6 leading-relaxed"
      >
        مصفوفة صفحات المصحف الشريف (604 صفحة) مقسمة حسب الأجزاء والأثمان لتوليد
        خطط حفظ دقيقة.
      </div>
      <ul
        class="list-none flex md:flex-col gap-2 md:text-left font-mono text-xs uppercase font-bold tracking-wider"
      >
        <li>
          <a
            href="#section-dates"
            class="hover:text-[#ff2400] transition-colors">01 / النطاق الزمني</a
          >
        </li>
        <li>
          <a
            href="#section-pages"
            class="hover:text-[#ff2400] transition-colors"
            >02 / مصفوفة الصفحات</a
          >
        </li>
        <li>
          <a
            href="#section-preview"
            class="hover:text-[#ff2400] transition-colors">03 / معاينة الموجه</a
          >
        </li>
      </ul>
    </div>
  </header>

  <!-- Main Container -->
  <main class="max-w-7xl mx-auto px-6 py-10 space-y-8">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <!-- Left Column: Controls -->
      <div class="space-y-8 lg:col-span-1">
        <!-- Section 1: Temporal Range -->
        <div
          id="section-dates"
          class="bg-white dark:bg-[#111111] border-custom p-6 space-y-4 shadow-sm"
        >
          <div
            class="border-b border-current pb-3 flex justify-between items-center"
          >
            <span class="font-mono text-xs font-bold text-[#ff2400]"
              >[ 01 ]</span
            >
            <h3 class="font-mono text-xs uppercase font-bold tracking-wider">
              إعدادات الفترة
            </h3>
          </div>
          <div class="space-y-3 font-mono text-xs">
            <div>
              <label
                for="start-date-input"
                class="block uppercase font-bold text-gray-500 mb-1"
                >تاريخ البداية:</label
              >
              <input
                type="date"
                id="start-date-input"
                class="custom-input w-full p-2 cursor-pointer text-current"
              />
            </div>
            <div>
              <label
                for="end-date-input"
                class="block uppercase font-bold text-gray-500 mb-1"
                >تاريخ النهاية:</label
              >
              <input
                type="date"
                id="end-date-input"
                class="custom-input w-full p-2 cursor-pointer text-current"
              />
            </div>
          </div>
        </div>

        <!-- Section 2: Prompt Feature Configuration -->
        <div
          class="bg-white dark:bg-[#111111] border-custom p-6 space-y-4 shadow-sm"
        >
          <div
            class="border-b border-current pb-3 flex justify-between items-center"
          >
            <span class="font-mono text-xs font-bold text-[#ff2400]"
              >[ 02 ]</span
            >
            <h3 class="font-mono text-xs uppercase font-bold tracking-wider">
              خصائص التطبيق المطلوبة
            </h3>
          </div>
          <div class="space-y-2 font-mono text-xs">
            <label
              class="flex items-center gap-3 p-2.5 border-custom cursor-pointer hover:bg-gray-50 dark:hover:bg-black transition-colors"
            >
              <input
                type="checkbox"
                id="opt-theme"
                checked
                class="accent-[#ff2400] w-4 h-4"
              />
              <span>زر الوضع الفاتح والداكن</span>
            </label>
            <label
              class="flex items-center gap-3 p-2.5 border-custom cursor-pointer hover:bg-gray-50 dark:hover:bg-black transition-colors"
            >
              <input
                type="checkbox"
                id="opt-json"
                checked
                class="accent-[#ff2400] w-4 h-4"
              />
              <span>تصدير واسترجاع JSON</span>
            </label>
            <label
              class="flex items-center gap-3 p-2.5 border-custom cursor-pointer hover:bg-gray-50 dark:hover:bg-black transition-colors"
            >
              <input
                type="checkbox"
                id="opt-view"
                checked
                class="accent-[#ff2400] w-4 h-4"
              />
              <span>التبديل بين الشبكة والقائمة</span>
            </label>
            <label
              class="flex items-center gap-3 p-2.5 border-custom cursor-pointer hover:bg-gray-50 dark:hover:bg-black transition-colors"
            >
              <input
                type="checkbox"
                id="opt-print"
                checked
                class="accent-[#ff2400] w-4 h-4"
              />
              <span>تنسيقات الطباعة (@media print)</span>
            </label>
          </div>
        </div>

        <!-- Action CTA Box -->
        <div
          class="sticky top-16 bg-white dark:bg-[#111111] border-custom p-6 space-y-4 shadow-md"
        >
          <div
            class="border-b border-current pb-3 flex justify-between items-center"
          >
            <span class="font-mono text-xs font-bold text-[#ff2400]"
              >[ 03 ]</span
            >
            <h3 class="font-mono text-xs uppercase font-bold tracking-wider">
              التنفيذ
            </h3>
          </div>
          <button
            type="button"
            id="copy-prompt-btn"
            class="w-full py-4 bg-[#ff2400] hover:bg-black dark:hover:bg-white dark:hover:text-black text-white font-mono font-bold text-xs uppercase tracking-wider transition-colors cursor-pointer flex items-center justify-center gap-2"
          >
            <span>⚡ توليد ونسخ موجه الذكاء الاصطناعي</span>
          </button>
          <div
            id="toast"
            class="hidden p-2 border border-[#ff2400] bg-[#ff2400]/10 text-[#ff2400] font-mono text-[11px] font-bold text-center uppercase"
          >
            ✓ تم النسخ بنجاح إلى الحافظة!
          </div>
        </div>
      </div>

      <!-- Right Column: Pages Selection Matrix Grouped by Juz -->
      <div
        id="section-pages"
        class="bg-white dark:bg-[#111111] border-custom p-6 space-y-6 lg:col-span-2 shadow-sm"
      >
        <div
          class="flex flex-wrap items-center justify-between gap-4 pb-4 border-b border-current"
        >
          <div>
            <span class="font-mono text-xs font-bold text-[#ff2400]"
              >[ MATRIX ]</span
            >
            <h2 class="text-lg font-black uppercase tracking-tight mt-0.5">
              اختيار صفحات المصحف (حسب الأجزاء)
            </h2>
          </div>
          <div class="flex items-center gap-2 font-mono">
            <button
              type="button"
              id="select-all"
              class="px-3 py-1.5 text-xs font-bold uppercase border border-current hover:bg-black hover:text-white dark:hover:bg-white dark:hover:text-black transition-colors cursor-pointer"
            >
              [ تحديد الكل ]
            </button>
            <button
              type="button"
              id="deselect-all"
              class="px-3 py-1.5 text-xs font-bold uppercase border border-current hover:bg-[#ff2400] hover:text-white transition-colors cursor-pointer"
            >
              [ إلغاء الكل ]
            </button>
          </div>
        </div>

        <!-- Juz Groups Accordions (Expanded by default) -->
        <div class="space-y-2.5 max-h-[640px] overflow-y-auto pl-1">
          {
            juzGroups.map((juz) => (
              <details
                open
                class="group bg-gray-50 dark:bg-black border-custom overflow-hidden transition-all [&[open]]:bg-white dark:[&[open]]:bg-[#181818]"
              >
                <summary class="flex items-center justify-between px-4 py-3 cursor-pointer select-none font-mono text-xs font-bold uppercase">
                  <div class="flex items-center gap-3">
                    <span class="text-[#ff2400]">الجزء {juz.juzNumber}</span>
                    <span class="text-[10px] text-gray-500">
                      [ الصفحات {juz.startPage} - {juz.endPage} ]
                    </span>
                  </div>
                  <div class="flex items-center gap-3">
                    <button
                      type="button"
                      class="select-juz-btn text-[10px] px-2 py-0.5 border border-current hover:bg-[#ff2400] hover:text-white hover:border-[#ff2400] transition-colors cursor-pointer"
                      data-juz={juz.juzNumber}
                    >
                      + تحديد الجزء كامل
                    </button>
                    <span class="text-xs group-open:rotate-180 transition-transform">
                      ▼
                    </span>
                  </div>
                </summary>

                <div class="p-3 border-t border-current grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-2 bg-white dark:bg-[#111111]">
                  {juz.pageList.map((pageItem) => {
                    const startSurah =
                      suwar[`${pageItem.range.start.surah}`]?.name?.ar ||
                      `سورة ${pageItem.range.start.surah}`;
                    const endSurah =
                      suwar[`${pageItem.range.end.surah}`]?.name?.ar ||
                      `سورة ${pageItem.range.end.surah}`;
                    return (
                      <label class="relative flex items-start gap-2 p-2 border border-gray-200 dark:border-gray-800 hover:border-[#ff2400] cursor-pointer transition-colors has-[:checked]:bg-[#ff2400]/5 has-[:checked]:border-[#ff2400] select-none text-xs">
                        <input
                          type="checkbox"
                          name="page-checkbox"
                          value={pageItem.id}
                          data-juz={juz.juzNumber}
                          class="mt-0.5 w-3.5 h-3.5 accent-[#ff2400] cursor-pointer"
                        />
                        <div class="space-y-0.5 w-full font-mono">
                          <div class="font-bold text-[#ff2400] text-[11px]">
                            صفحة {pageItem.id}
                          </div>
                          <div class="text-gray-600 dark:text-gray-400 text-[10px] leading-tight truncate">
                            بداية:{" "}
                            <span class="font-bold text-current">
                              {startSurah} ({pageItem.range.start.ayah})
                            </span>
                          </div>
                        </div>
                      </label>
                    );
                  })}
                </div>
              </details>
            ))
          }
        </div>
      </div>
    </div>

    <!-- Section 4: Output Preview Box -->
    <section
      id="section-preview"
      class="bg-white dark:bg-[#111111] border-custom p-6 space-y-3 shadow-sm"
    >
      <div class="flex items-center justify-between font-mono text-xs">
        <span class="font-bold uppercase text-[#ff2400]"
          >[ معاينة الموجه الحية ]</span
        >
        <span class="text-gray-500">UTF-8 / MARKDOWN</span>
      </div>
      <textarea
        id="prompt-preview"
        rows="8"
        readonly
        class="w-full bg-gray-50 dark:bg-black border border-current p-4 font-mono text-xs text-current leading-relaxed resize-none focus:outline-none"
        placeholder="اختر التواريخ والصفحات أعلاه لتوليد نص الموجه..."
      ></textarea>
    </section>
  </main>

  <!-- Footer -->
  <footer
    class="bg-white dark:bg-[#111111] border-t border-current py-6 mt-12 font-mono text-xs uppercase"
  >
    <div
      class="max-w-7xl mx-auto px-6 flex flex-wrap justify-between items-center gap-4"
    >
      <div>&copy; 2026 HIFZ ARCHIVE // نظام التخطيط الهندسي</div>
      <div class="text-[#ff2400] font-bold">إصدار الأرشيف</div>
    </div>
  </footer>

  <script define:vars={{ pagesData: pages, suwarData: suwar }}>
    // Theme Switcher
    const themeToggleBtn = document.getElementById("theme-toggle-btn");
    const themeModeLabel = document.getElementById("theme-mode-label");

    function initTheme() {
      const savedTheme = localStorage.getItem("theme");
      const prefersDark = window.matchMedia(
        "(prefers-color-scheme: dark)",
      ).matches;

      if (savedTheme === "dark" || (!savedTheme && prefersDark)) {
        document.documentElement.classList.add("dark");
        themeModeLabel.textContent = "داكن";
      } else {
        document.documentElement.classList.remove("dark");
        themeModeLabel.textContent = "فاتح";
      }
    }

    themeToggleBtn.addEventListener("click", () => {
      const isDark = document.documentElement.classList.toggle("dark");
      localStorage.setItem("theme", isDark ? "dark" : "light");
      themeModeLabel.textContent = isDark ? "داكن" : "فاتح";
    });

    initTheme();

    // Elements
    const selectAllBtn = document.getElementById("select-all");
    const deselectAllBtn = document.getElementById("deselect-all");
    const checkboxes = document.querySelectorAll('input[name="page-checkbox"]');
    const juzSelectButtons = document.querySelectorAll(".select-juz-btn");
    const copyPromptBtn = document.getElementById("copy-prompt-btn");
    const startDateInput = document.getElementById("start-date-input");
    const endDateInput = document.getElementById("end-date-input");
    const promptPreview = document.getElementById("prompt-preview");
    const toast = document.getElementById("toast");
    const selectionCounter = document.getElementById("selection-counter");

    const optTheme = document.getElementById("opt-theme");
    const optJson = document.getElementById("opt-json");
    const optView = document.getElementById("opt-view");
    const optPrint = document.getElementById("opt-print");

    // Default Dates
    const today = new Date();
    const nextMonth = new Date();
    nextMonth.setMonth(today.getMonth() + 1);

    startDateInput.value = today.toISOString().split("T")[0];
    endDateInput.value = nextMonth.toISOString().split("T")[0];

    function updateCounter() {
      const count = Array.from(checkboxes).filter((cb) => cb.checked).length;
      selectionCounter.textContent = `[ تم تحديد ${count} صفحة ]`;
    }

    selectAllBtn.addEventListener("click", () => {
      checkboxes.forEach((cb) => (cb.checked = true));
      updateCounter();
      updatePreview();
    });

    deselectAllBtn.addEventListener("click", () => {
      checkboxes.forEach((cb) => (cb.checked = false));
      updateCounter();
      updatePreview();
    });

    juzSelectButtons.forEach((btn) => {
      btn.addEventListener("click", (e) => {
        e.preventDefault();
        const juzNum = btn.getAttribute("data-juz");
        const juzCheckboxes = document.querySelectorAll(
          `input[name="page-checkbox"][data-juz="${juzNum}"]`,
        );
        const allChecked = Array.from(juzCheckboxes).every((cb) => cb.checked);
        juzCheckboxes.forEach((cb) => (cb.checked = !allChecked));
        updateCounter();
        updatePreview();
      });
    });

    checkboxes.forEach((cb) =>
      cb.addEventListener("change", () => {
        updateCounter();
        updatePreview();
      }),
    );

    startDateInput.addEventListener("change", updatePreview);
    endDateInput.addEventListener("change", updatePreview);
    [optTheme, optJson, optView, optPrint].forEach((opt) =>
      opt?.addEventListener("change", updatePreview),
    );

    function buildPromptText() {
      const selectedIds = Array.from(checkboxes)
        .filter((cb) => cb.checked)
        .map((cb) => Number(cb.value))
        .sort((a, b) => a - b);

      if (selectedIds.length === 0) {
        return "خطأ: الرجاء اختيار صفحة واحدة على الأقل.";
      }

      const startDateVal = startDateInput.value;
      const endDateVal = endDateInput.value;

      if (!startDateVal || !endDateVal) {
        return "خطأ: الرجاء تحديد تاريخ البداية والنهاية.";
      }

      const start = new Date(startDateVal);
      const end = new Date(endDateVal);

      if (end <= start) {
        return "تنبيه: يجب أن يكون تاريخ النهاية بعد تاريخ البداية.";
      }

      const diffTime = Math.abs(end.getTime() - start.getTime());
      const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
      const diffWeeks = Math.max(1, Math.ceil(diffDays / 7));

      let selectedDetails = selectedIds
        .map((id) => {
          const range = pagesData[id];
          const startSurah =
            suwarData[range.start.surah]?.name?.ar ||
            `سورة ${range.start.surah}`;
          const endSurah =
            suwarData[range.end.surah]?.name?.ar || `سورة ${range.end.surah}`;
          return `الصفحة ${id}: من ${startSurah} (${range.start.ayah}) إلى ${endSurah} (${range.end.ayah})`;
        })
        .join("\n");

      let specs = [];
      specs.push(
        "1. دعم أرقام الأعداد العربية القياسية فقط (1, 2, 3...) في كافة أرجاء الواجهة.",
      );
      if (optTheme?.checked)
        specs.push("2. توفير خيار الوضع الفاتح والداكن (Light/Dark Mode).");
      specs.push("3. التنسيق باللغة العربية (RTL) واستخدام الخطوط المتناسقة.");
      if (optView?.checked)
        specs.push("4. التبديل بين طريقة عرض الشبكة والقائمة (Grid/List).");
      if (optPrint?.checked)
        specs.push("5. تحسين تنسيقات الطباعة (@media print).");

      let functions = [];
      functions.push("1. جدول توزيع صفحات الأسبوع ومنظومة الإنجاز.");
      functions.push("2. شريط بحث حيّ وتصفية سريعة حسب رقم الصفحة أو السورة.");
      if (optJson?.checked) {
        functions.push(
          `3. هيكل تخزين وحفظ الحالة محلياً عبر JSON:\n\`\`\`json\n{\n  "version": "1.0",\n  "startDate": "${startDateVal}",\n  "endDate": "${endDateVal}",\n  "completedPages": [${selectedIds.slice(0, 3).join(", ")}]\n}\n\`\`\``,
        );
      }

      return `أريدك أن تكتب لي كود ملف HTML واحد (Single HTML file) متكامل مع تنسيقات Tailwind CSS وجماليات التصميم المعماري الدقيق (خطوط واضحة، مساحات بيضاء، إطار أسود، واللون الأحمر المميز #ff2400) يعمل كـ "مخطط تفاعلي لحفظ صفحات القرآن الكريم (604 صفحة)".

المواصفات المطلوبة في الواجهة:
${specs.join("\n")}

معلومات الخطة الزمنية:
- تاريخ البداية: ${startDateVal}
- تاريخ النهاية: ${endDateVal}
- المدة الإجمالية: ${diffDays} يوماً (~${diffWeeks} أسابيع)

الصفحات المفصلة المطلوب جدولتها:
${selectedDetails}

الوظائف والتفاعلية المطلوبة:
${functions.join("\n")}

تسليم الكود البرمجي كاملاً ونظيفاً ضمن صندوق أكواد واحد فقط جاهز للتشغيل.`;
    }

    function updatePreview() {
      promptPreview.value = buildPromptText();
    }

    updateCounter();
    updatePreview();

    copyPromptBtn.addEventListener("click", () => {
      const textToCopy = buildPromptText();
      if (textToCopy.startsWith("خطأ") || textToCopy.startsWith("تنبيه")) {
        alert(textToCopy);
        return;
      }
      navigator.clipboard.writeText(textToCopy).then(() => {
        toast.classList.remove("hidden");
        setTimeout(() => toast.classList.add("hidden"), 3000);
      });
    });
  </script>
</Layout>
